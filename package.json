{
  "name": "agentterm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "dev:app": "tauri dev",
    "tauri": "tauri",
    "check": "python3 scripts/verify_project.py && python3 scripts/run_quality.py",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --write README.md CLAUDE.md CHANGELOG.md docs src index.html package.json vite.config.ts tsconfig.json eslint.config.js src-tauri/*.json",
    "format:check": "prettier --check README.md CLAUDE.md CHANGELOG.md docs src index.html package.json vite.config.ts tsconfig.json eslint.config.js src-tauri/*.json"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
